{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "outDir": "./dist/electron",
    "rootDir": "./electron"
  },
  "include": ["electron/**/*"],
  "exclude": ["node_modules"]
}
